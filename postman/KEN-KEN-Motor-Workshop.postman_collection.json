{
  "info": {
    "name": "KEN KEN Motor - Tes API Workshop",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Jalankan WorkshopSeeder lalu php artisan serve. Buat dan pilih environment lokal dengan owner_password dan mechanic_password. Kirim Login Owner dan Login Mekanik untuk menyimpan token masing-masing. Jalankan request pencarian sebelum detail yang memakai ID dari hasil pencarian. Koleksi ini membaca data bisnis; login dan logout hanya mengelola token."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{workshop_owner_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "owner_email",
      "value": "owner.bengkel@kenkenmotor.test",
      "type": "string"
    },
    {
      "key": "mechanic_email",
      "value": "mekanik.bengkel@kenkenmotor.test",
      "type": "string"
    },
    {
      "key": "part_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "purchase_order_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "work_order_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "shipment_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Owner - Login dan profil",
      "item": [
        {
          "name": "Login Owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{workshop_login_payload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const password = pm.environment.get(\"owner_password\");",
                  "pm.environment.unset(\"workshop_owner_token\");",
                  "if (!password) {",
                  "    console.error(\"Pilih environment dan isi owner_password di nilai lokal.\");",
                  "    pm.execution.skipRequest();",
                  "} else {",
                  "    pm.variables.set(\"workshop_login_payload\", JSON.stringify({",
                  "        email: pm.collectionVariables.get(\"owner_email\"),",
                  "        password,",
                  "        device_name: \"Postman KEN KEN Motor\"",
                  "    }));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const result = pm.response.json();",
                  "    pm.test(\"Login sebagai Owner dan token tersedia\", () => {",
                  "        pm.expect(result.user.role).to.equal(\"owner\");",
                  "        pm.expect(result.token).to.be.a(\"string\").and.not.be.empty;",
                  "    });",
                  "    if (result.user.role === \"owner\" && result.token) {",
                  "        pm.environment.set(\"workshop_owner_token\", result.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Profil Owner",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/user"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Role owner\", () => pm.expect(pm.response.json().data.role).to.equal(\"owner\"));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
